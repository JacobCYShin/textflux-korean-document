# Copy to a private .env file, or export these values in your shell.
# Paths are placeholders; substitute your own layout.

# Repository checkout
BENCH=/path/to/textflux-korean-document-benchmark

# Source images and masks. Keep these outside Git.
INPUTS=/path/to/private-inputs

# Where runs/ is written
OUTPUT=/path/to/output-root

# Model payload containing flux-fill-dev/ and textflux/
MODEL_ROOT=/path/to/payload

# Font with Hangul coverage
FONT=/path/to/NotoSansCJKkr-Regular.otf

# Runtime container image tag
IMAGE=textflux-offline:2026-08-25
