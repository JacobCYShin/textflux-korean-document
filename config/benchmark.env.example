# Copy to config/benchmark.env and edit. Load with:
#   set -a; . config/benchmark.env; set +a
#
# Two roots, deliberately separate. See docs/getting-started.md.

# Repository checkout: code, docs, cases. This is what git clone gives you.
BENCH=/path/to/textflux-korean-document

# Workspace: machine state. Never version-controlled.
WORKSPACE=/path/to/workspace

# Derived from the workspace. Listed separately because scripts take them
# individually and they can be relocated.
INPUTS=/path/to/workspace/private-inputs
OUTPUT=/path/to/workspace
MODEL_ROOT=/path/to/workspace/payload
FONT=/path/to/workspace/fonts/NotoSansCJKkr-Regular.otf

# Runtime container image tag
IMAGE=textflux-offline:2026-08-25
